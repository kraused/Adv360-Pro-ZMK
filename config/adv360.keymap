#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        macro_opt_cmd_c: macro_opt_cmd_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT &kp LGUI>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LALT &kp LGUI>;

            label = "MACRO_OPT_CMD_C";
        };

        macro_opt_cmd_v: macro_opt_cmd_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT &kp LGUI>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LALT &kp LGUI>;

            label = "MACRO_OPT_CMD_V";
        };

        ctrl_a: ctrl_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRL_A";
        };

        ctrl_e: ctrl_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRL_E";
        };

        alt_left: alt_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_LEFT";
        };

        alt_right: alt_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_RIGHT";
        };

        alt_0: alt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp NUMBER_0>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_0";
        };

        alt_1: alt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp NUMBER_1>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_1";
        };

        alt_2: alt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp NUMBER_2>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_2";
        };

        alt_3: alt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp NUMBER_3>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_3";
        };

        alt_4: alt_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp NUMBER_4>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_4";
        };

        alt_5: alt_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp NUMBER_5>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_5";
        };

        alt_6: alt_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp NUMBER_6>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_6";
        };

        alt_7: alt_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp NUMBER_7>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_7";
        };

        alt_8: alt_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp NUMBER_8>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_8";
        };

        alt_9: alt_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp NUMBER_9>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_9";
        };

        alt_enter: alt_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp ENTER>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_ENTER";
        };

        alt_w: alt_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp W>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_W";
        };

        alt_a: alt_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_A";
        };

        alt_s: alt_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_S";
        };

        alt_d: alt_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp D>,
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_D";
        };

        alt_shift_a: alt_shift_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp LSHIFT>;
                <&macro_release>,
                <&kp LALT>;

            label = "ALT_SHIFT_A";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none      &kp N1    &kp N2  &kp N3    &kp N4     &kp N5  &tog 1                                                                 &mo 3      &kp N6  &kp N7  &kp N8     &kp N9   &kp N0           &none
&kp TAB    &kp Q     &kp W   &kp E     &kp R      &kp T   &mo 3                                                                  &none      &kp Y   &kp U   &kp I      &kp O    &kp P            &kp BSLH
&kp ESC    &lt 1 A   &kp S   &kp D     &kp F      &kp G   &none     &none    &none                 &none              &none      &none      &kp H   &kp J   &kp K      &kp L    &lt 1 SEMICOLON  &kp SQT
&kp LSHFT  &lt 2 Z   &kp X   &kp C     &kp V      &kp B                      &none                 &none                                    &kp N   &kp M   &kp COMMA  &kp DOT  &lt 2 FSLH       &kp RSHFT
&kp LCTRL  &kp LALT  &none   &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL  &kp LEFT_COMMAND      &kp RIGHT_COMMAND  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &none    &kp RALT         &kp RCTRL
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none      &kp N1     &kp N2     &kp N3                &kp N4                 &kp N5          &trans                                                        &mo 3  &kp N6           &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &none
&none      &kp GRAVE  &none      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp MINUS       &none                                                         &none  &none            &kp N7        &kp N8        &kp N9        &none         &none
&none      &none      &kp EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_SHIFT  &none   &none  &none                 &none             &none  &none  &kp RIGHT_SHIFT  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &none         &none
&kp LSHFT  &none      &none      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none                          &none                 &none                           &kp NUMBER_0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none         &kp RSHFT
&none      &none      &none      &alt_left             &alt_right                             &none   &none  &macro_opt_cmd_c      &macro_opt_cmd_v  &none  &none                   &ctrl_a       &ctrl_e       &none         &none         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1      &kp F2  &kp F3  &kp F4  &kp F5  &kp F6      &tog 1                                  &mo 3  &kp F7        &kp F8        &kp F9        &kp F10       &kp F11  &kp F12
&none       &none   &none   &none   &none   &none       &none                                   &none  &none         &none         &none         &none         &none    &none
&none       &none   &none   &none   &none   &kp LSHIFT  &none   &none  &none      &none  &none  &none  &kp RSHIFT    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none    &none
&kp LSHIFT  &none   &none   &none   &none   &none                      &none      &none                &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none    &kp RSHIFT
&none       &none   &none   &none   &none               &none   &none  &none      &none  &none  &none                &none         &none         &none         &none    &none
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                  &trans                  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                                            &bootloader             &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &rgb_ug RGB_MEFS_CMD 5  &none       &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none           &none         &none         &bl BL_INC    &bl BL_DEC                  &rgb_ug RGB_TOG         &bl BL_TOG  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
